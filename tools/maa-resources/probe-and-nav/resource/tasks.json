  "MarkRecoveryReturned": {"algorithm": "JustReturn", "action": "Stop"},
  "MarkRecoveryNoReturn": {"algorithm": "JustReturn", "action": "Stop"},
  "ProbeRestoreNormal": {
    "algorithm": "OcrDetect",
    "text": [
      "普通难度",
