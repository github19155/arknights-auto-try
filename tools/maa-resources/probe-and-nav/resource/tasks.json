{
  "RecoveryScreenCheck": {
    "algorithm": "JustReturn",
    "action": "DoNothing",
    "next": ["RecoveryEndOfAction", "RecoveryMissionFailed", "RecoveryStoryConfirm", "RecoveryStory", "MarkRecoveryOther"]
  },
  "RecoveryEndOfAction": {
    "baseTask": "EndOfAction",
    "template": "Battle/BattleFlag/EndOfAction.png",
    "action": "DoNothing",
    "next": ["MarkRecoveryResult"]
  },
  "RecoveryMissionFailed": {
    "baseTask": "FightMissionFailed",
    "action": "DoNothing",
    "preDelay": 0,
    "next": ["MarkRecoveryResult"],
    "onErrorNext": [],
    "exceededNext": []
  },
  "RecoveryStoryConfirm": {
    "baseTask": "SkipThePreBattlePlotConfirm",
    "template": "Battle/Plot/SkipThePreBattlePlotConfirm.png",
    "action": "DoNothing",
    "next": ["MarkRecoveryStory"]
  },
  "RecoveryStory": {
    "baseTask": "SkipThePreBattlePlot",
    "template": "Battle/Plot/SkipThePreBattlePlot.png",
    "action": "DoNothing",
    "next": ["MarkRecoveryStory"]
  },
  "MarkRecoveryResult": {"algorithm": "JustReturn", "action": "Stop"},
  "MarkRecoveryStory": {"algorithm": "JustReturn", "action": "Stop"},
  "MarkRecoveryOther": {"algorithm": "JustReturn", "action": "Stop"},
